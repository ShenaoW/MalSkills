digraph SDG {
    graph [
        rankdir=LR,
        splines=true,
        pad=0.28,
        nodesep=0.38,
        ranksep=0.62,
        bgcolor="white",
        fontname="Helvetica"
    ];

    node [
        fontname="Helvetica",
        fontsize=11,
        color="#475569",
        margin="0.16,0.10"
    ];

    edge [
        color="#64748B",
        penwidth=1.35,
        arrowsize=0.72,
        fontname="Helvetica",
        fontsize=10
    ];

    subgraph cluster_artifacts {
        label="Artifact Nodes";
        color="#CBD5E1";
        style="rounded";

        art_skill [label="A1 Artifact\nSKILL.md", shape=box, style="rounded,filled", fillcolor="#ECFEFF", color="#0891B2"];
        art_config [label="A2 Artifact\ndiagnostic.yaml", shape=box, style="rounded,filled", fillcolor="#FFF7ED", color="#EA580C"];
        art_post [label="A3 Artifact\npost.js", shape=box, style="rounded,filled", fillcolor="#EEF2FF", color="#4F46E5"];
    }

    subgraph cluster_ssos {
        label="SSO Nodes";
        color="#CBD5E1";
        style="rounded";

        sso_read [label="R1 SSO\ncontent_read_and_parse\ncollectDirectory(plan.bundle_dir)", shape=box, style="rounded,filled", fillcolor="#D1FAE5", color="#059669"];
        sso_exec [label="R2 SSO\ndiagnostic_command_execution\ncommands in diagnostic.yaml populate bundle_dir", shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB"];
        sso_send [label="R3 SSO\noutbound_connection\naxios.post(plan.remote, payload)", shape=box, style="rounded,filled", fillcolor="#FCE7F3", color="#DB2777"];
    }

    subgraph cluster_operands {
        label="Operand Nodes";
        color="#CBD5E1";
        style="rounded";

        op_bundle [label="O1 Operand\nobj::result_dir::diagnostic_bundle", shape=ellipse, style="filled", fillcolor="#FEF3C7", color="#D97706"];
        op_target_group [label="O2 Operand\nobj::secret_targets::credentials_profiles_logs", shape=ellipse, style="filled", fillcolor="#FEF3C7", color="#D97706"];
        op_helper [label="O3 Operand\nobj::diagnostic_plan::commands", shape=ellipse, style="filled", fillcolor="#FEF3C7", color="#D97706"];
        op_remote [label="O4 Operand\nobj::config_key::remote", shape=ellipse, style="filled", fillcolor="#FEF3C7", color="#D97706"];
        op_external [label="O5 Operand\nobj::endpoint::https://diagnostics-sync.example.com/upload", shape=ellipse, style="filled", fillcolor="#FEF3C7", color="#D97706"];
    }

    art_config -> sso_exec [label="contains"];
    art_post -> sso_send [label="contains"];
    art_post -> sso_read [label="contains"];
    art_config -> op_remote [label="contains"];
    art_config -> op_target_group [label="contains"];
    art_config -> op_bundle [label="contains"];

    sso_read -> op_target_group [label="has_operand"];
    sso_read -> op_bundle [label="has_operand"];
    sso_exec -> op_helper [label="has_operand"];
    sso_send -> op_remote [label="has_operand"];
    sso_send -> op_bundle [label="has_operand"];

    op_remote -> op_external [label="flows_to", color="#2563EB"];
    op_target_group -> op_bundle [label="flows_to", color="#2563EB"];

    sso_read -> sso_send [label="same_operand", color="#DC2626", penwidth=2.0];
}
