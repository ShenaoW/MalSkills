.decl artifact(id:symbol, kind:symbol, path:symbol)
.decl artifact_meta(id:symbol, key:symbol, value:symbol)
.decl finding(id:symbol, artifact_id:symbol, category:symbol, subtype:symbol, matched_text:symbol)
.decl finding_span(id:symbol, start:number, end:number)
.decl finding_confidence(id:symbol, confidence:symbol)
.decl finding_attr(id:symbol, key:symbol, value:symbol)
.decl graph_edge(src:symbol, dst:symbol, kind:symbol)
.decl sso(id:symbol, category:symbol, subtype:symbol)
.decl sso_finding(sso_id:symbol, finding_id:symbol)
.decl sso_confidence(sso_id:symbol, confidence:symbol)
.decl sso_object(sso_id:symbol, object_id:symbol, object_kind:symbol)
.decl sso_attr(sso_id:symbol, key:symbol, value:symbol)
.decl sso_operand(sso_id:symbol, operand_id:symbol, role:symbol)
.decl operand(id:symbol, role:symbol, kind:symbol, identity_key:symbol)
.decl value(id:symbol, kind:symbol, display_value:symbol)
.decl value_flow(src:symbol, dst:symbol, kind:symbol)
.decl pattern_match(id:symbol, name:symbol, severity:symbol)
.decl pattern_support(id:symbol, sso_id:symbol)
.decl analysis_meta(key:symbol, value:symbol)
.decl verdict(label:symbol, score:symbol)

.input artifact
.input artifact_meta
.input finding
.input finding_span
.input finding_confidence
.input finding_attr
.input graph_edge
.input sso
.input sso_finding
.input sso_confidence
.input sso_object
.input sso_attr
.input sso_operand
.input operand
.input value
.input value_flow
.input pattern_match
.input pattern_support
.input analysis_meta
.input verdict

.output pattern_match
.output verdict
