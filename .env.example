# Copy this file to .env, fill only the services you use, and run:
#   chmod 600 .env
# Select the LLM mode, model, stage switches, and timeouts in malskills.toml.

# Shared LLM API used by MalSkills and every LLM-backed baseline.
MALSKILLS_LLM_BASE_URL=https://provider.example/v1
MALSKILLS_LLM_API_KEY=replace-with-your-api-key

# Optional external baseline services.
# SNYK_TOKEN=replace-with-your-snyk-token
# VIRUSTOTAL_API_KEY=replace-with-your-virustotal-key

# Optional local tool overrides.
# MALSKILLS_CODEX_CLI=/absolute/path/to/codex
# MALSKILLS_CLAUDE_CLI=/absolute/path/to/claude
# MALSKILLS_YASA_UAST_SDK=/absolute/path/to/uast-sdk

# Optional RQ3 multi-model comparison profiles. These are used only by
# experiments/run_rq3_llm_comparison.py; uncomment complete profiles as needed.
# RQ3_CLAUDE_MODEL=claude-model-name
# RQ3_CLAUDE_API_KEY=replace-with-claude-key
# CLAUDE_API_URL=https://provider.example/v1
#
# RQ3_GEMINI_MODEL=gemini-model-name
# RQ3_GEMINI_API_KEY=replace-with-gemini-key
# GEMINI_API_URL=https://provider.example/v1
#
# RQ3_QWEN_MODEL=qwen-model-name
# RQ3_QWEN_API_KEY=replace-with-qwen-key
# RQ3_QWEN_API_URL=https://provider.example/v1
#
# RQ3_DEEPSEEK_MODEL=deepseek-model-name
# RQ3_DEEPSEEK_API_KEY=replace-with-deepseek-key
# DEEPSEEK_API_URL=https://provider.example/v1

# Optional performance tuning. Defaults are normally sufficient.
# MALSKILLS_LLM_SSO_BATCH_SIZE=6
# MALSKILLS_LLM_OBJECT_MAX_WORKERS=2
# MALSKILLS_LLM_OBJECT_MAX_PROMPT_BYTES=80000
# MALSKILLS_LLM_FEEDBACK_MAX_REVIEWS=8
# MALSKILLS_SEMGREP_TIMEOUT_SEC=120
# NO_COLOR=1
